{
  // Type-check the popup's plain JavaScript; nothing is emitted (no build step).
  // The popup's <script>s share one global scope, which matches how TypeScript
  // treats non-module files in one program. background.js is a separate realm,
  // so it has its own config (tsconfig.background.json).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": false
  },
  "files": [
    "types/messenger.d.ts",
    "types/globals.d.ts",
    "types/palette.d.ts",
    "lib/fuzzy.js",
    "lib/vcard.js",
    "popup/early.js",
    "popup/timing.js",
    "popup/palette.js",
    "popup/commands/compose.js",
    "popup/commands/messages.js",
    "popup/commands/tags.js",
    "popup/commands/view.js",
    "popup/commands/thunderbird.js",
    "popup/commands/navigation.js",
    "popup/commands/folders.js",
    "popup/commands/search.js",
    "popup/main.js"
  ]
}
