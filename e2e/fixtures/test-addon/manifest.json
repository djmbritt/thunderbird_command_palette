{
  "manifest_version": 3,
  "name": "E2E Test Add-on",
  "description": "Fixture for the palette's end-to-end tests: one shortcut command and a toolbar button.",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "test-addon@e2e.example", "strict_min_version": "128.0" } },
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Test button", "default_popup": "popup.html" },
  "commands": { "say-hello": { "description": "Say hello" } },
  "permissions": ["storage"]
}
