{
  "manifest_version": 3,
  "name": "Command Palette",
  "description": "VSCode-style command palette for Thunderbird. Press Ctrl+Shift+P to summon.",
  "version": "1.0.1",
  "author": "David Britt",
  "homepage_url": "https://github.com/djmbritt/thunderbird_command_palette",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "command-palette@djmbritt.github.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Command Palette",
    "default_popup": "popup/palette.html",
    "allowed_spaces": [],
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "64": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open the Command Palette"
    },
    "palette-repeat-last": {
      "description": "Repeat the last palette command"
    },
    "palette-move-to": {
      "description": "Move selected messages to folder…"
    },
    "palette-tag-with": {
      "description": "Tag selected messages…"
    },
    "palette-switch-tab": {
      "description": "Switch to tab…"
    },
    "palette-write-to": {
      "description": "Write to contact…"
    },
    "palette-go-to-folder": {
      "description": "Go to folder…"
    },
    "palette-search": {
      "description": "Search messages…"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesDelete",
    "compose",
    "addressBooks",
    "tabs",
    "storage",
    "accountsFolders",
    "messagesTagsList",
    "compose.send",
    "compose.save",
    "notifications"
  ],
  "experiment_apis": {
    "palette": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "palette"
          ]
        ],
        "script": "experiments/implementation.js"
      }
    }
  }
}
